[Desktop Entry]
Type=Application
Name=Luma
GenericName=Image Viewer
Comment=Fast minimal image viewer with local text recognition
Exec=luma %f
Icon=luma
Terminal=false
Categories=Graphics;Viewer;
StartupWMClass=luma
MimeType=image/jpeg;image/png;image/gif;image/heic;image/heif;image/webp;image/avif;image/bmp;image/x-bmp;image/x-dib;image/tiff;image/vnd.microsoft.icon;image/x-icon;image/svg+xml;
