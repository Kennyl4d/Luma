<Window x:Class="Luma.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource L.About}" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" Icon="Assets/Luma.ico" FontFamily="Segoe UI" FontSize="14">
 <StackPanel Margin="26">
  <StackPanel Orientation="Horizontal"><Image Source="Assets/Luma.ico" Width="48" Height="48" Margin="0,0,14,0"/><TextBlock Text="Luma" FontSize="30" VerticalAlignment="Center"/></StackPanel>
  <TextBlock Text="{DynamicResource L.Description}" TextWrapping="Wrap" Margin="0,14,0,18"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock Text="{DynamicResource L.Version}"/><TextBlock x:Name="VersionValue" Grid.Column="1"/>
   <TextBlock Text="{DynamicResource L.Author}" Grid.Row="1" Margin="0,8,0,0"/><TextBlock Text="KENNY" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
   <TextBlock Text="{DynamicResource L.Formats}" Grid.Row="2" Margin="0,8,0,0"/><TextBlock TextWrapping="Wrap" Text="JPEG · PNG · GIF · HEIC/HEIF · WebP · AVIF · BMP/DIB · TIFF · ICO · SVG" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>
  </Grid>
  <TextBlock Text="{DynamicResource L.Privacy}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,10"/>
  <TextBlock Text="{DynamicResource L.SelectionTip}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
  <Button Content="{DynamicResource L.Close}" HorizontalAlignment="Right" IsCancel="True" Click="CloseClick"/>
 </StackPanel>
</Window>
